# Choose mock or supabase. Missing DATA_MODE defaults to mock.
# Copy to .env.local and restart Expo after changing the mode.
EXPO_PUBLIC_DATA_MODE=mock
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Debug iOS builds only. RevenueCat Test Store keys crash release/TestFlight builds.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
# Set REVENUECAT_SECRET_KEY only in Supabase Edge Function secrets, never here.
